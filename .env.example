# Copie para .env e use uma senha longa, única e sem ; no exemplo local.
SQL_PASSWORD=CHANGE_ME_StrongPassword_123!
MSSQL_PID=Developer
ASPNETCORE_ENVIRONMENT=Production
FRONTEND_URL=http://localhost:3300
PUBLIC_API_URL=http://localhost:5300
# Deixe os quatro campos vazios para a interface demonstrativa.
# A API permanece protegida; o modo demo nunca desabilita JWT.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_FRONTEND_CLIENT_ID=
ENTRA_API_SCOPE=
AI_ENABLED=false
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=
AI_KEY=
AI_AUTH_MODE=Bearer
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_FROM=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_LOGO_URL=
